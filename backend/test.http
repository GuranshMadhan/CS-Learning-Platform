### =================================================================
### PART 1: INFINITE MODE (Single Player Grind)
### =================================================================

### 1. Register a Standard User (Infinite Grinder)
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "GrindMaster",
  "email": "grinder@test.com",
  "password": "password123",
  "role": "USER"
}
> {%
    client.global.set("grinder_token", response.body.token);
%}

### 2. Get Infinite Questions (Needs Token from #1)
GET http://localhost:8080/api/v1/questions/infinite
Authorization: Bearer {{grinder_token}}

### 3. Submit Answer for Question ID 1 (Earn XP)
POST http://localhost:8080/api/v1/questions/1/submit
Authorization: Bearer {{grinder_token}}
Content-Type: application/json

{
  "answer": "1"
}


### =================================================================
### PART 2: PORTAL SYSTEM (Multiplayer Classrooms)
### =================================================================

### 4. Register a TEACHER (Mr. Smith)
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "MrSmith",
  "email": "teacher@school.com",
  "password": "password123",
  "role": "ADMIN"
}
> {%
    client.global.set("teacher_token", response.body.token);
%}

### 5. Teacher Creates a Classroom
POST http://localhost:8080/api/v1/classrooms/create
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
  "name": "CS 101 - Intro to Java"
}
> {%
    // SAVE THE PORTAL CODE AND ID
    client.global.set("portal_code", response.body.portalCode);
    client.global.set("classroom_id", response.body.id);
    client.log("Generated Class ID: " + response.body.id);
    client.log("Generated Portal Code: " + response.body.portalCode);
%}

### 6. Register a STUDENT (Jimmy)
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "username": "JimmyStudent",
  "email": "jimmy@school.com",
  "password": "password123",
  "role": "USER"
}
> {%
    client.global.set("student_token", response.body.token);
%}

### 7. Student Joins the Class (Using the code from Step 5)
POST http://localhost:8080/api/v1/classrooms/join
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
  "code": "{{portal_code}}"
}

### 8. Teacher Creates a Quiz (Week 1 Test)
POST http://localhost:8080/api/v1/quizzes/create
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
  "classroomId": {{classroom_id}},
  "title": "Week 1: Java Basics",
  "description": "Test your knowledge of variables and loops."
}
> {%
    client.global.set("quiz_id", response.body.id);
%}

### 9. Student Checks for Quizzes
GET http://localhost:8080/api/v1/quizzes/classroom/{{classroom_id}}
Authorization: Bearer {{student_token}}

### 10. Teacher Adds a Question to the Quiz
POST http://localhost:8080/api/v1/quizzes/add-question
Authorization: Bearer {{teacher_token}}
Content-Type: application/json

{
  "quizId": {{quiz_id}},
  "content": "What is the capital of France?",
  "option1": "London",
  "option2": "Berlin",
  "option3": "Paris",
  "option4": "Madrid",
  "correctAnswer": "Paris"
}
> {%
    client.global.set("quiz_question_id", response.body.id);
%}

### 11. Student Submits the Quiz
POST http://localhost:8080/api/v1/quizzes/{{quiz_id}}/submit
Authorization: Bearer {{student_token}}
Content-Type: application/json

{
  "question_{{quiz_question_id}}": "Paris"
}